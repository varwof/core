{
  "version": "v1",
  "description": "core API route authorization rules. Edit this file to add/change/remove API permissions. Hot-reloaded on SIGHUP.",
  "public_paths": [
    "/healthz",
    "/readyz",
    "/",
    "/tsa",
    "/timestamp",
    "/ocsp",
    "/ocsp/*",
    "/api/v1/users/login",
    "/api/v1/users/info",
    "/api/v1/users/logout",
    "/api/v1/session",
    "/api/v1/version",
    "/api/v1/dns-query",
    "/api/v1/permissions/roles",
    "/metrics",
    "/.well-known/jwks.json",
    "/oauth/token",
    "/pki/*"
  ],
  "rules": [
    {"method":"POST","path":"/api/v1/certs","permission":"cert:issue","description":"签发证书","ca_scope":true},
    {"method":"POST","path":"/api/v1/certs/upload","permission":"cert:issue","description":"上传CSR签发"},
    {"method":"POST","path":"/api/v1/certs/batch","permission":"cert:batch","description":"批量签发（handler 内校验 ca_scope）"},
    {"method":"POST","path":"/api/v1/certs/async","permission":"cert:issue","description":"异步签发提交"},
    {"method":"GET","path":"/api/v1/certs/async/{id}","permission":"cert:list","description":"异步签发状态"},
    {"method":"POST","path":"/api/v1/certs/revoke-by-principal","permission":"user:revoke-all","description":"按人吊销AIC","require_role":["superadmin","admin"]},
    {"method":"POST","path":"/api/v1/certs/revoke-batch","permission":"user:revoke-all","description":"批量吊销（吊销洪峰，引擎内存即真相）","require_role":["superadmin","admin"]},
    {"method":"POST","path":"/api/v1/cert/{ca}/{serial}/revoke","permission":"cert:revoke","description":"吊销证书","ca_scope":true},
    {"method":"POST","path":"/api/v1/cert/{ca}/{serial}/renew","permission":"cert:renew","description":"续期证书","ca_scope":true},
    {"method":"GET","path":"/api/v1/cert/{ca}/{serial}/export","permission":"cert:export","description":"导出证书","ca_scope":true},
    {"method":"POST","path":"/api/v1/cert/{ca}/{serial}/re-sign","permission":"cert:issue","description":"重签证书","ca_scope":true},
    {"method":"GET","path":"/api/v1/cert/by-key","permission":"cert:list","description":"按公钥查询"},
    {"method":"GET","path":"/api/v1/certs","permission":"cert:list","description":"列出证书"},
    {"method":"POST","path":"/api/v1/crl/{ca}/generate","permission":"crl:generate","description":"生成CRL","ca_scope":true},
    {"method":"GET","path":"/api/v1/ca/{name}","permission":"ca:info","description":"CA详情","ca_scope":true},
    {"method":"GET","path":"/api/v1/ca/{name}/rotation","permission":"ca:info","description":"CA密钥轮换状态","ca_scope":true},
    {"method":"POST","path":"/api/v1/ca/{name}/rotate","permission":"config:write","description":"CA主密钥轮换（过渡期双签）","require_role":["superadmin","admin"]},
    {"method":"GET","path":"/api/v1/cas","permission":"ca:list","description":"列出CA"},
    {"method":"POST","path":"/api/v1/cas/import","permission":"ca:create","description":"导入CA"},
    {"method":"POST","path":"/api/v1/user/revoke-all","permission":"user:revoke-all","description":"吊销用户全部证书","require_role":["superadmin","admin"]},
    {"method":"POST","path":"/api/v1/sub-cas","permission":"ca:create","description":"创建子CA（仅superadmin）"},
    {"method":"GET","path":"/api/v1/sub-cas","permission":"ca:list","description":"列出子CA"},
    {"method":"GET","path":"/api/v1/sub-ca/{name}","permission":"ca:info","description":"子CA详情","ca_scope":true},
    {"method":"POST","path":"/api/v1/sub-ca/{name}/revoke","permission":"cert:revoke","description":"吊销子CA","ca_scope":true},
    {"method":"POST","path":"/api/v1/sub-ca/{name}/revoke-all","permission":"cert:revoke","description":"吊销子CA下所有证书","ca_scope":true},
    {"method":"POST","path":"/api/v1/agent/register","permission":"agent:manage","description":"注册Agent"},
    {"method":"POST","path":"/api/v1/aic/issue","permission":"cert:issue","description":"签发AIC"},
    {"method":"PUT","path":"/api/v1/admin/config","permission":"config:write","description":"修改配置","require_role":["superadmin"]},
    {"method":"GET","path":"/api/v1/admin/config","permission":"config:read","description":"读取配置"},
    {"method":"GET","path":"/api/v1/trust","permission":"trust:list","description":"列出信任锚"},
    {"method":"POST","path":"/api/v1/trust","permission":"trust:import","description":"导入信任锚"},
    {"method":"POST","path":"/api/v1/webhooks","permission":"webhook:manage","description":"创建Webhook","require_role":["superadmin","admin"]},
    {"method":"GET","path":"/api/v1/webhooks","permission":"webhook:manage","description":"列出Webhook订阅","require_role":["superadmin","admin"]},
    {"method":"DELETE","path":"/api/v1/webhooks","permission":"webhook:manage","description":"删除Webhook订阅","require_role":["superadmin","admin"]},
    {"method":"POST","path":"/api/v1/ra/{id}/approve","permission":"ra:approve","description":"审批RA"},
    {"method":"POST","path":"/api/v1/ra/{id}/reject","permission":"ra:reject","description":"拒绝RA"},
    {"method":"POST","path":"/api/v1/keys/recover","permission":"key:recover","description":"密钥恢复"},
    {"method":"POST","path":"/api/v1/cross-cert/issue","permission":"cross-cert:issue","description":"签发交叉证书"},
    {"method":"POST","path":"/api/v1/cross-cert/revoke","permission":"cross-cert:revoke","description":"吊销交叉证书"},
    {"method":"POST","path":"/api/v1/reports/compliance","permission":"report:generate","description":"生成合规报告"},
    {"method":"GET","path":"/api/v1/reports/compliance","permission":"report:view","description":"查看合规报告"},
    {"method":"GET","path":"/api/v1/tsa/cert","permission":"config:write","description":"查看TSA签名者证书","require_role":["superadmin","admin"]},
    {"method":"POST","path":"/api/v1/tsa/cert/renew","permission":"config:write","description":"续期TSA签名者证书","require_role":["superadmin","admin"]},
    {"method":"POST","path":"/api/v1/tsa/cert/rotate","permission":"config:write","description":"轮换TSA签名者密钥","require_role":["superadmin","admin"]},
    {"method":"GET","path":"/api/v1/tsa/ca","permission":"config:write","description":"查看TSA CA证书","require_role":["superadmin","admin"]},
    {"method":"POST","path":"/api/v1/tsa/ca/renew","permission":"config:write","description":"续期TSA CA证书","require_role":["superadmin","admin"]},
    {"method":"GET","path":"/api/v1/audit","permission":"log:read","description":"读取审计日志"},
    {"method":"GET","path":"/api/v1/dns/{name}","permission":"dns:manage","description":"DNS记录管理"},
    {"method":"GET","path":"/api/v1/permissions/check","permission":"ca:list","description":"权限检查"},
    {"method":"GET","path":"/api/v1/users","permission":"user:list","description":"列出用户"},
    {"method":"POST","path":"/api/v1/users","permission":"user:manage","description":"管理用户"},
    {"method":"POST","path":"/api/v1/users/{id}/operator-cert","permission":"user:manage","description":"绑定操作证书","require_role":["superadmin","admin"]},
    {"method":"DELETE","path":"/api/v1/users/{id}/operator-cert","permission":"user:manage","description":"解绑操作证书","require_role":["superadmin","admin"]},
    {"method":"GET","path":"/api/v1/tokens","permission":"user:list","description":"列出API Token"},
    {"method":"POST","path":"/api/v1/tokens","permission":"user:manage","description":"创建API Token","allow_aic":false},
    {"method":"DELETE","path":"/api/v1/tokens/{id}","permission":"user:manage","description":"删除API Token","allow_aic":false},
    {"method":"GET","path":"/metrics","permission":"ca:list","description":"Prometheus 指标","require_role":["superadmin","admin","ops","operator"]},
    {"method":"GET","path":"/swagger/**","permission":"swagger:view","description":"Swagger UI"},
    {"method":"GET","path":"/api/**","permission":"ca:list","description":"API兜底（只读）"},
    {"method":"GET","path":"/cas","permission":"web:view","description":"CA列表页"},
    {"method":"GET","path":"/certs","permission":"web:view","description":"证书列表页"},
    {"method":"GET","path":"/dashboard","permission":"web:view","description":"仪表盘"},
    {"method":"GET","path":"/topology","permission":"ca:list","description":"拓扑图"},
    {"method":"GET","path":"/ca/*","permission":"web:view","description":"CA详情页"},
    {"method":"GET","path":"/cert/*","permission":"web:view","description":"证书详情页"},
    {"method":"GET","path":"/swagger/**","permission":"swagger:view","description":"Swagger UI"},
    {"method":"*","path":"/api/**","permission":"ca:list","description":"API兜底（全部方法）"}
  ]
}
